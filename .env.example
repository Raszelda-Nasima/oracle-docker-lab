# Oracle Lab Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR OWN VALUES
# DO NOT COMMIT .env TO VERSION CONTROL

ORACLE_SID=XE
ORACLE_PDB=XEPDB1
ORACLE_CHARACTERSET=AL32UTF8
ORACLE_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Connection Details
# Host: localhost
# Port: 1521
# Service Name: XE or XEPDB1
# Username: system or admin
# Password: (from ORACLE_PASSWORD above)

# SQL*Plus Connection String:
# sqlplus system/<your_password>@localhost:1521/xe

# Enterprise Manager Express:
# http://localhost:5500/em
# Username: sys
# Password: <your_password> (with 'as sysdba')
